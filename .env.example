# The Daily Wow — environment. Copy to .env.local. Keys are supplied by the editor in Vercel/Supabase; never commit them.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
EDITOR_NAME=רף
EDITOR_EMAIL=raphco@gmail.com
EDITOR_TIMEZONE=Asia/Jerusalem
EMAIL_FROM="הוואו היומי <hello@your-domain>"
EDITIONS_REPO_URL=https://github.com/raphacoh/daily-wow-editions

# Database: Supabase Postgres (transaction pooler, port 6543) — or an embedded PGlite folder for local dev:
#   DATABASE_URL=pglite://./.pglite
DATABASE_URL=

# Supabase Auth (magic links)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrets (32+ random chars each)
SESSION_SECRET=
LINK_KEY=
EDITOR_API_KEY=
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_DAILY_LIMIT=100

# Assistant (Anthropic)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
ASSISTANT_DAILY_CAP=30
FREE_MESSAGES_PER_DAY=3
DEMO_POOL_PER_DAY=30

# Payments (Dodo)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=
USD_ILS=3.7

# Dev only
DEV_SEED=0
EDITIONS_WRITE_LOCAL=0
